---
import { homeData } from '#/data';
import DeliveryVariantB from '#/components/delivery/DeliveryVariantB.astro';
import Freshness from '#/components/freshness/Freshness.astro';
import Header from '#/components/header/Header.astro';
import Hero from '#/components/hero/Hero.astro';
import History from '#/components/history/History.astro';
import Layout from '#/layouts/Layout.astro';
---

<Layout title="Кварта — обжарка в Минске">
	<Header data={homeData.headerData} />
	<main>
		<Hero data={homeData.heroData} />
		<Freshness data={homeData.freshnessData} />
		<History data={homeData.historyData} />
		<DeliveryVariantB data={homeData.deliveryData} />
	</main>
</Layout>