---
import { homeData } from '#/data';
import ContactVariantA from '#/components/contact/variants/ContactVariantA.astro';
import ContactVariantB from '#/components/contact/variants/ContactVariantB.astro';
import ContactVariantC from '#/components/contact/variants/ContactVariantC.astro';
import Drips from '#/components/drips/Drips.astro';
import Freshness from '#/components/freshness/Freshness.astro';
import Header from '#/components/header/Header.astro';
import Hero from '#/components/hero/Hero.astro';
import History from '#/components/history/History.astro';
import Frames from '#/components/frames/Frames.astro';
import Layout from '#/layouts/Layout.astro';
---

<Layout title="Кварта — обжарка в Минске">
	<Header data={homeData.headerData} />
	<main>
		<Hero data={homeData.heroData} />
		<Freshness data={homeData.freshnessData} />
		<History data={homeData.historyData} />
		<Frames data={homeData.framesData} />
		<Drips data={homeData.dripsData} />
		<ContactVariantA data={homeData.contactData} />
		<ContactVariantB data={homeData.contactData} />
		<ContactVariantC data={homeData.contactData} />
	</main>
</Layout>