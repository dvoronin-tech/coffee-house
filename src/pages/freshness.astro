---
import '../styles/tokens.scss';
import Freshness from '../components/freshness/Freshness.astro';
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Свежесть — Кварта</title>
	</head>
	<body>
		<main>
			<Freshness />
		</main>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--color-cream);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-weight: 400;
	}
</style>
