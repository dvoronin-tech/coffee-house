---
import '../styles/tokens.scss';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Мастерская в Минске. Зерно оказывается у вас на 1–3 день после обжарки.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
