---
interface Props {
	label: string;
}

const { label } = Astro.props;
const tail = label.startsWith('К') ? label.slice(1) : label;
---

<span class="mark" aria-hidden="true">
	<span class="mark__letter">
		К
		<svg class="mark__bean" viewBox="0 0 36 52">
			<path
				fill="var(--color-peach)"
				d="M18 2.5c8.2 1.2 14 9.6 14 23.5S26.4 49.2 18 49.5 4 40.2 4 26 9.8 3.6 18 2.5z"
			/>
			<path
				d="M18.2 9c3.8 5.2 4 28.4.1 34"
				fill="none"
				stroke="var(--color-ink)"
				stroke-width="2"
				stroke-linecap="round"
			/>
		</svg>
	</span>
	<span class="mark__tail">{tail}</span>
</span>

<style lang="scss">
	.mark {
		display: inline-flex;
		align-items: baseline;
		color: var(--color-ink);
		line-height: 1;
	}

	.mark__letter,
	.mark__tail {
		font-family: var(--font-display);
		font-size: 2.8rem;
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.mark__letter {
		position: relative;
		display: inline-block;
	}

	.mark__bean {
		position: absolute;
		top: -0.45rem;
		right: -0.15rem;
		width: 1.15rem;
		height: 1.55rem;
		transform: rotate(-26deg);
		pointer-events: none;
	}

	.mark__tail {
		margin-left: -0.04em;
	}
</style>
