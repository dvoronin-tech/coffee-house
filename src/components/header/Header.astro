---
import type { HeaderData } from '../../types/header';
import LogoMark from './LogoMark.astro';

interface Props {
	data: HeaderData;
}

const { logoLabel, logoHref, links, cta } = Astro.props.data;
---

<header class="header" id="top">
	<div class="header__veil" aria-hidden="true"></div>
	<div class="header__bar">
		<a class="header__logo" href={logoHref} aria-label={logoLabel}>
			<LogoMark label={logoLabel} />
		</a>
		<nav class="header__nav" aria-label="Разделы">
			<ul class="header__links">
				{
					links.map((link) => (
						<li>
							<a class="header__link" href={link.href}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a class="header__cta" href={cta.href}>{cta.label}</a>
	</div>
</header>

<style lang="scss">
	.header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 30;
		background: transparent;
		color: var(--color-ink);
	}

	.header__veil {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		background-color: var(--surface-glass);
		border-bottom: 0.1rem solid
			color-mix(in srgb, var(--color-ink) 14%, var(--color-line));
		backdrop-filter: blur(1.2rem);
	}

	.header__bar {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
		min-height: 7.2rem;
		margin-inline: auto;
		padding: 1.2rem var(--page-gutter);
	}

	.header__logo {
		justify-self: start;
		color: inherit;
		text-decoration: none;
	}

	.header__nav {
		justify-self: center;
	}

	.header__links {
		display: flex;
		gap: 3.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.header__link {
		color: var(--color-ink);
		font-size: 1.6rem;
		line-height: 1.2;
		text-decoration: none;
		transition: color 0.2s ease;

		&:hover {
			color: var(--color-muted);
		}
	}

	.header__cta {
		justify-self: end;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 4.4rem;
		padding: 0.8rem 2.2rem;
		border-radius: 4.8rem;
		background-color: var(--color-peach);
		color: var(--color-ink);
		font-size: 1.6rem;
		line-height: 1.2;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;

		&:hover {
			background-color: var(--color-ink);
			color: var(--color-cream);
		}
	}

	.header__logo:focus-visible,
	.header__link:focus-visible,
	.header__cta:focus-visible {
		outline: 0.2rem solid var(--color-ink);
		outline-offset: 0.4rem;
	}

	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.header__veil {
				animation: header-veil linear both;
				animation-timeline: scroll(root block);
				animation-range: 0rem 4.8rem;
			}
		}
	}

	@keyframes header-veil {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.header__veil {
			animation: none;
			opacity: 1;
		}

		.header__link,
		.header__cta {
			transition: none;
		}
	}
</style>
