---
import type { HeaderData } from '../../types/header';
import LogoMark from './LogoMark.astro';

interface Props {
	data: HeaderData;
}

const { logoLabel, logoHref, links, cta, activeMark, marks } = Astro.props.data;
const active = marks.find((mark) => mark.id === activeMark) ?? marks[0];
---

<header class="header" id="top">
	<div class="header__veil" aria-hidden="true"></div>
	<div class="header__bar">
		<a class="header__logo" href={logoHref} aria-label={logoLabel}>
			<LogoMark id={active.id} label={logoLabel} />
		</a>
		<nav class="header__nav" aria-label="Разделы">
			<ul class="header__links">
				{
					links.map((link) => (
						<li>
							<a class="header__link" href={link.href}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a class="header__cta" href={cta.href}>{cta.label}</a>
	</div>
	<aside class="header__samples" aria-label="Варианты знака">
		<p class="header__samples-label">Три знака</p>
		<ul class="header__samples-list">
			{
				marks.map((mark) => (
					<li
						class:list={[
							'header__sample',
							{ 'header__sample--on': mark.id === active.id },
						]}
					>
						<LogoMark id={mark.id} label={logoLabel} />
						<span class="header__sample-name">{mark.name}</span>
						<span class="header__sample-note">
							{mark.note}
							{mark.id === active.id ? ' · в шапке' : ''}
						</span>
					</li>
				))
			}
		</ul>
	</aside>
</header>

<style lang="scss">
	.header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 30;
		background: transparent;
		color: var(--color-ink);
	}

	.header__veil {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		background-color: var(--surface-glass);
		border-bottom: 0.1rem solid
			color-mix(in srgb, var(--color-ink) 14%, var(--color-line));
		backdrop-filter: blur(1.2rem);
	}

	.header__bar {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
		min-height: 7.2rem;
		margin-inline: auto;
		padding: 1.2rem var(--page-gutter);
	}

	.header__logo {
		justify-self: start;
		color: inherit;
		text-decoration: none;
	}

	.header__nav {
		justify-self: center;
	}

	.header__links {
		display: flex;
		gap: 3.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.header__link {
		color: var(--color-ink);
		font-size: 1.6rem;
		line-height: 1.2;
		text-decoration: none;
		transition: color 0.2s ease;

		&:hover {
			color: var(--color-muted);
		}
	}

	.header__cta {
		justify-self: end;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 4.4rem;
		padding: 0.8rem 2.2rem;
		border-radius: 4.8rem;
		background-color: var(--color-peach);
		color: var(--color-cream);
		font-size: 1.6rem;
		line-height: 1.2;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;

		&:hover {
			background-color: var(--color-ink);
			color: var(--color-cream);
		}
	}

	.header__logo:focus-visible,
	.header__link:focus-visible,
	.header__cta:focus-visible {
		outline: 0.2rem solid var(--color-ink);
		outline-offset: 0.4rem;
	}

	.header__samples {
		position: fixed;
		z-index: 1;
		bottom: 2.4rem;
		left: 50%;
		translate: -50% 0;
		display: flex;
		align-items: center;
		gap: 2.4rem;
		max-width: calc(100vw - 4.8rem);
		padding: 1.4rem 1.6rem 1.4rem 2.4rem;
		background-color: var(--color-paper);
		border: 0.1rem solid var(--color-line);
		border-radius: 2.4rem 0 2.4rem 2.4rem;
	}

	.header__samples-label {
		margin: 0;
		color: var(--color-muted);
		font-size: 1.4rem;
		line-height: 1.3;
	}

	.header__samples-list {
		display: flex;
		gap: 1.2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.header__sample {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.7rem;
		min-width: 18rem;
		padding: 1.2rem 1.6rem 1rem;
		border: 0.1rem solid transparent;
		border-radius: 1.6rem;
	}

	.header__sample--on {
		background-color: var(--color-cream);
		border-color: var(--color-ink);
	}

	.header__sample-name {
		font-size: 1.4rem;
		line-height: 1.2;
	}

	.header__sample-note {
		color: var(--color-muted);
		font-size: 1.3rem;
		line-height: 1.2;
	}

	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.header__veil {
				animation: header-veil linear both;
				animation-timeline: scroll(root block);
				animation-range: 0rem 4.8rem;
			}
		}
	}

	@keyframes header-veil {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.header__veil {
			animation: none;
			opacity: 1;
		}

		.header__link,
		.header__cta {
			transition: none;
		}
	}
</style>
