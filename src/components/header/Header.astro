---
import type { HeaderData } from '#/types/header';
import LogoMark from '#/components/header/LogoMark.astro';

interface Props {
	data: HeaderData;
}

const { logoLabel, logoHref, links, cta } = Astro.props.data;
---

<header class="header" id="top">
	<div class="header__veil" aria-hidden="true"></div>
	<div class="header__bar">
		<a class="header__logo" href={logoHref} aria-label={logoLabel}>
			<LogoMark label={logoLabel} />
		</a>
		<nav class="header__nav" aria-label="Разделы">
			<ul class="header__links">
				{
					links.map((link) => (
						<li>
							<a class="header__link" href={link.href}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<details class="header__menu">
			<summary class="header__summary">Меню</summary>
			<nav class="header__panel" aria-label="Разделы">
				<ul class="header__links">
					{
						links.map((link) => (
							<li>
								<a class="header__link" href={link.href}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</details>
		<a class="header__cta" href={cta.href}>{cta.label}</a>
	</div>
</header>

<style lang="scss">
	.header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 30;
		background: transparent;
		color: var(--color-text);
	}

	.header__veil {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		background-color: var(--color-surface-glass);
		border-bottom: 0.1rem solid
			color-mix(in srgb, var(--color-text) 14%, var(--color-border));
		backdrop-filter: blur(1.2rem);
	}

	.header__bar {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
		height: var(--header-height);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.header__logo {
		justify-self: start;
		color: inherit;
		text-decoration: none;
	}

	.header__nav {
		justify-self: center;
	}

	.header__menu {
		display: none;
	}

	.header__links {
		display: flex;
		gap: 3.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.header__link {
		color: var(--color-text);
		font-size: 1.6rem;
		line-height: 1.2;
		text-decoration: none;
		transition: color 0.2s ease;

		&:hover {
			color: var(--color-secondary-text);
		}
	}

	.header__cta {
		justify-self: end;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 4.4rem;
		padding: 0.8rem 2.2rem;
		border-radius: 4.8rem;
		background-color: var(--color-accent);
		color: var(--color-background);
		font-size: 1.6rem;
		line-height: 1.2;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;

		&:hover {
			background-color: var(--color-text);
			color: var(--color-background);
		}
	}

	.header__logo:focus-visible,
	.header__link:focus-visible,
	.header__cta:focus-visible,
	.header__summary:focus-visible {
		outline: 0.2rem solid var(--color-text);
		outline-offset: 0.4rem;
	}

	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.header__veil {
				animation: header-veil linear both;
				animation-timeline: scroll(root block);
				animation-range: 0rem 4.8rem;
			}
		}
	}

	@keyframes header-veil {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.header__veil {
			animation: none;
			opacity: 1;
		}

		.header__link,
		.header__cta,
		.header__summary {
			transition: none;
		}
	}

	@media (max-width: 1024px) {
		.header__links {
			gap: 2.4rem;
		}
	}

	@media (max-width: 768px) {
		.header__bar {
			grid-template-columns: 1fr auto auto;
			column-gap: 1.2rem;
		}

		.header__nav {
			display: none;
		}

		.header__menu {
			display: block;
			justify-self: end;
		}

		.header__summary {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 4.4rem;
			padding: 0.8rem 1.6rem;
			border: 0.1rem solid var(--color-border);
			border-radius: 4.8rem;
			background-color: var(--color-surface);
			color: var(--color-text);
			font-family: var(--font-text);
			font-size: 1.6rem;
			line-height: 1.2;
			white-space: nowrap;
			list-style: none;
			cursor: pointer;
			transition:
				color 0.2s ease,
				border-color 0.2s ease;

			&::-webkit-details-marker {
				display: none;
			}

			&::marker {
				content: '';
			}

			&:hover {
				color: var(--color-secondary-text);
			}
		}

		.header__menu[open] .header__summary {
			border-color: var(--color-accent);
		}

		.header__panel {
			position: absolute;
			top: 100%;
			right: 0;
			left: 0;
			z-index: 2;
			padding: 0.8rem var(--page-gutter) 1.6rem;
			background-color: var(--color-surface);
			border-bottom: 0.1rem solid var(--color-border);
		}

		.header__panel .header__links {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}

		.header__panel .header__link {
			display: flex;
			align-items: center;
			min-height: 4.4rem;
		}

		@media (prefers-reduced-motion: reduce) {
			.header__summary {
				transition: none;
			}
		}
	}

	@media (max-width: 480px) {
		.header__bar {
			column-gap: 0.8rem;
		}

		.header__summary {
			padding-inline: 1.2rem;
		}

		.header__cta {
			padding-inline: 1.6rem;
		}
	}
</style>
