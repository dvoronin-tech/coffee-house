---
import type { DeliveryData } from '#/types/delivery';

interface Props {
	data: DeliveryData;
}

const { shipping, pickup } = Astro.props.data;
---

<section id="delivery" class="delivery" aria-label="Доставка и самовывоз">
	<div class="delivery__inner">
		<article class="delivery__card delivery__card--shipping">
			<h2 class="delivery__title">{shipping.title}</h2>
			<dl class="delivery__facts">
				{
					shipping.facts.map((fact) => (
						<div class="delivery__fact">
							<dt class="delivery__label">{fact.label}</dt>
							<dd class="delivery__value">{fact.value}</dd>
						</div>
					))
				}
			</dl>
			<p class="delivery__note">{shipping.subscriptionNote}</p>
			<p class="delivery__note delivery__note--muted">{shipping.scopeNote}</p>
		</article>
		<article class="delivery__card delivery__card--pickup">
			<h2 class="delivery__title">{pickup.title}</h2>
			<dl class="delivery__facts">
				{
					pickup.facts.map((fact) => (
						<div class="delivery__fact">
							<dt class="delivery__label">{fact.label}</dt>
							<dd class="delivery__value">{fact.value}</dd>
						</div>
					))
				}
			</dl>
			<p class="delivery__contacts">
				<a class="delivery__phone" href={pickup.phoneHref}>
					{pickup.phoneValue}
				</a>
				<a
					class="delivery__map"
					href={pickup.mapHref}
					target="_blank"
					rel="noopener noreferrer"
				>
					{pickup.mapLabel}
				</a>
			</p>
		</article>
	</div>
</section>

<style lang="scss">
	@keyframes delivery-rise {
		from {
			opacity: 0;
			transform: translateY(4.8rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@mixin rise($range) {
		@media (prefers-reduced-motion: no-preference) {
			@supports (animation-timeline: view()) {
				animation: delivery-rise auto linear both;
				animation-timeline: view();
				animation-range: #{$range};
			}
		}
	}

	.delivery {
		background-color: var(--color-background);
		color: var(--color-text);
		padding: 9.6rem var(--page-gutter);
	}

	.delivery__inner {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 4.8rem;
		max-width: var(--page-width);
		margin: 0 auto;
	}

	.delivery__card {
		padding: 4.8rem 4rem 4.4rem;
		background-color: var(--color-surface);
		border: 0.1rem solid var(--color-border);

		&--shipping {
			border-radius: 4.8rem 0 4.8rem 4.8rem;

			@include rise('cover 10% cover 30%');
		}

		&--pickup {
			border-radius: 0 4.8rem 4.8rem 4.8rem;

			@include rise('cover 16% cover 36%');
		}
	}

	.delivery__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 4rem;
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	.delivery__facts {
		margin: 3.2rem 0 0;
	}

	.delivery__fact {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 2.4rem;
		padding-block: 1.4rem;

		& + & {
			border-top: 0.1rem solid var(--color-border);
		}
	}

	.delivery__label {
		margin: 0;
		color: var(--color-secondary-text);
		font-size: 1.4rem;
		line-height: 1.3;
	}

	.delivery__value {
		margin: 0;
		font-size: 1.6rem;
		line-height: 1.3;
		text-align: right;
	}

	.delivery__note {
		margin: 2.4rem 0 0;
		font-size: 1.6rem;
		line-height: 1.5;

		&--muted {
			color: var(--color-secondary-text);
		}
	}

	.delivery__contacts {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 2.4rem;
		margin: 2.4rem 0 0;
		padding-top: 1.4rem;
		border-top: 0.1rem solid var(--color-border);
	}

	.delivery__phone {
		font-size: 1.6rem;
		line-height: 1.3;
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.4rem;
		transition: text-decoration-color 0.2s ease;

		&:hover {
			text-decoration-color: var(--color-accent);
		}
	}

	.delivery__map {
		color: var(--color-accent);
		font-size: 1.6rem;
		line-height: 1.3;
		text-decoration: none;

		&::after {
			content: ' ↗';
		}

		&:hover {
			color: var(--color-text);
		}
	}

	.delivery__phone:focus-visible,
	.delivery__map:focus-visible {
		outline: 0.2rem solid var(--color-text);
		outline-offset: 0.4rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.delivery__card--shipping,
		.delivery__card--pickup {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
