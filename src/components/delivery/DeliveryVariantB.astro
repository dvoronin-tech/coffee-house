---
import type { DeliveryData } from '#/types/delivery';

interface Props {
	data: DeliveryData;
}

const { shipping, pickup } = Astro.props.data;
---

<section id="delivery" class="delivery" aria-label="Доставка и самовывоз">
	<div class="delivery__inner">
		<article class="delivery__column delivery__column--shipping">
			<p class="delivery__eyebrow">{shipping.eyebrow}</p>
			<h2 class="delivery__title">{shipping.title}</h2>
			<dl class="delivery__lines">
				{
					shipping.facts.map((fact) => (
						<div class="delivery__line">
							<dt class="delivery__term">{fact.label}</dt>
							<dd class="delivery__description">{fact.value}</dd>
						</div>
					))
				}
			</dl>
			<p class="delivery__note">{shipping.subscriptionNote}</p>
			<p class="delivery__note delivery__note--muted">{shipping.scopeNote}</p>
		</article>
		<article class="delivery__column delivery__column--pickup">
			<p class="delivery__eyebrow">{pickup.eyebrow}</p>
			<h2 class="delivery__title">{pickup.title}</h2>
			<dl class="delivery__lines">
				{
					pickup.facts.map((fact) => (
						<div class="delivery__line">
							<dt class="delivery__term">{fact.label}</dt>
							<dd class="delivery__description">{fact.value}</dd>
						</div>
					))
				}
			</dl>
			<p class="delivery__links">
				<a class="delivery__phone" href={pickup.phoneHref}>
					{pickup.phoneValue}
				</a>
				<a
					class="delivery__map"
					href={pickup.mapHref}
					target="_blank"
					rel="noopener noreferrer"
				>
					{pickup.mapLabel}
				</a>
			</p>
		</article>
	</div>
</section>

<style lang="scss">
	@keyframes delivery-rise {
		from {
			opacity: 0;
			transform: translateY(4.8rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@mixin rise($range) {
		@media (prefers-reduced-motion: no-preference) {
			@supports (animation-timeline: view()) {
				animation: delivery-rise auto linear both;
				animation-timeline: view();
				animation-range: #{$range};
			}
		}
	}

	.delivery {
		background-color: var(--color-background);
		color: var(--color-text);
		padding: 9.6rem var(--page-gutter);
	}

	.delivery__inner {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		max-width: var(--page-width);
		margin: 0 auto;
	}

	.delivery__column {
		&--shipping {
			padding-right: 6.4rem;

			@include rise('cover 10% cover 30%');
		}

		&--pickup {
			padding-left: 6.4rem;
			border-left: 0.1rem solid var(--color-border);

			@include rise('cover 16% cover 36%');
		}
	}

	.delivery__eyebrow {
		margin: 0;
		color: var(--color-secondary-text);
		font-size: 1.4rem;
		line-height: 1.2;
	}

	.delivery__title {
		display: inline-block;
		margin: 1.6rem 0 0;
		padding-bottom: 2.4rem;
		border-bottom: 0.1rem solid var(--color-border);
		font-family: var(--font-display);
		font-size: 4.8rem;
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	.delivery__lines {
		margin: 3.2rem 0 0;
	}

	.delivery__line {
		display: flex;
		align-items: baseline;
		gap: 1.6rem;
		padding-block: 0.8rem;
	}

	.delivery__term {
		margin: 0;
		min-width: 14rem;
		color: var(--color-secondary-text);
		font-size: 1.6rem;
		line-height: 1.4;
	}

	.delivery__description {
		margin: 0;
		font-family: var(--font-display);
		font-size: 2.4rem;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.delivery__note {
		margin: 2.4rem 0 0;
		font-size: 1.6rem;
		line-height: 1.5;

		&--muted {
			color: var(--color-secondary-text);
		}
	}

	.delivery__links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.2rem;
		margin: 3.2rem 0 0;
	}

	.delivery__phone {
		font-size: 1.8rem;
		line-height: 1.3;
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.4rem;
		transition: text-decoration-color 0.2s ease;

		&:hover {
			text-decoration-color: var(--color-accent);
		}
	}

	.delivery__map {
		color: var(--color-accent);
		font-size: 1.6rem;
		line-height: 1.3;
		text-decoration: none;

		&::after {
			content: ' ↗';
		}

		&:hover {
			color: var(--color-text);
		}
	}

	.delivery__phone:focus-visible,
	.delivery__map:focus-visible {
		outline: 0.2rem solid var(--color-text);
		outline-offset: 0.4rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.delivery__column--shipping,
		.delivery__column--pickup {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
