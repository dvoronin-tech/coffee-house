---
import type { FreshnessData } from '../../types/freshness';

interface Props {
	data: FreshnessData;
}

const { data } = Astro.props;
---

<section class="freshness" aria-labelledby="freshness-title">
	<div class="freshness__inner">
		<div class="freshness__intro">
			<h2 id="freshness-title" class="freshness__title">{data.title}</h2>
			<p class="freshness__lead">{data.lead}</p>
		</div>
		<ol class="freshness__steps">
			{
				data.steps.map((step) => (
					<li
						class:list={[
							'freshness__step',
							{ 'freshness__step--accent': step.accent },
						]}
					>
						<span class="freshness__index" aria-hidden="true">
							{step.index}
						</span>
						<p class="freshness__copy">
							<span class="freshness__name">{step.name}</span>
							<span class="freshness__when">{step.when}</span>
						</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style lang="scss">
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(3rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@mixin rise($start, $end, $delay: 0s) {
		@media (prefers-reduced-motion: no-preference) {
			@supports (animation-timeline: view()) {
				animation-name: rise;
				animation-duration: auto;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: view();
				animation-range: entry #{$start} entry #{$end};
			}

			@supports not (animation-timeline: view()) {
				animation-name: rise;
				animation-duration: 0.7s;
				animation-delay: $delay;
				animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
				animation-fill-mode: both;
			}
		}
	}

	.freshness {
		background: var(--color-cream, #fffaf5);
		color: var(--color-ink, #2b2118);
		padding: 9.6rem var(--page-gutter, 4.8rem);

		&__inner {
			max-width: var(--page-width, 120rem);
			margin: 0 auto;
		}

		&__intro {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			column-gap: 6.4rem;
			align-items: start;
		}

		&__title {
			margin: 0;
			max-width: 48rem;
			font-family: var(--font-display, 'Noto Serif', Georgia, serif);
			font-size: 4.8rem;
			font-weight: 400;
			line-height: 1.08;
			letter-spacing: -0.02em;
			text-wrap: balance;

			@include rise(0%, 24%, 0s);
		}

		&__lead {
			margin: 0.6rem 0 0;
			max-width: 46rem;
			font-family: var(--font-text, 'Noto Sans', Helvetica, Arial, sans-serif);
			font-size: 1.8rem;
			font-weight: 400;
			line-height: 1.5;
			letter-spacing: -0.02em;

			@include rise(10%, 36%, 0.12s);
		}

		&__steps {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			overflow: hidden;
			margin: 7.2rem 0 0;
			padding: 0;
			list-style: none;
			background: var(--color-paper, #fdf3ea);
			border: 0.1rem solid var(--color-line, #eadfd5);
			border-radius: 4.8rem 0 4.8rem 4.8rem;
		}

		&__step {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: 4.8rem;
			min-height: 22rem;
			margin: 0;
			padding: 4rem 3.6rem 3.6rem;

			&:not(:last-child) {
				border-right: 0.1rem solid var(--color-line, #eadfd5);
			}

			&:nth-child(1) {
				@include rise(18%, 44%, 0.24s);
			}

			&:nth-child(2) {
				@include rise(26%, 52%, 0.36s);
			}

			&:nth-child(3) {
				@include rise(34%, 60%, 0.48s);
			}
		}

		&__index {
			display: block;
			font-family: var(--font-display, 'Noto Serif', Georgia, serif);
			font-size: 2rem;
			font-weight: 400;
			line-height: 1;
			letter-spacing: -0.02em;
			color: var(--color-muted, #7a6b5d);
		}

		&__copy {
			margin: 0;
		}

		&__name,
		&__when {
			display: block;
			font-weight: 400;
			letter-spacing: -0.02em;
		}

		&__name {
			font-family: var(--font-display, 'Noto Serif', Georgia, serif);
			font-size: 4rem;
			line-height: 1;
		}

		&__when {
			margin-top: 1.2rem;
			max-width: 24rem;
			font-family: var(--font-text, 'Noto Sans', Helvetica, Arial, sans-serif);
			font-size: 1.8rem;
			line-height: 1.35;
			color: var(--color-muted, #7a6b5d);
		}

		&__step--accent {
			.freshness__name,
			.freshness__index {
				color: var(--color-peach, #e89b6d);
			}
		}
	}
</style>
