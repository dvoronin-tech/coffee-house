---
import type { FooterData } from '#/types/footer';
import LogoMark from '#/components/header/LogoMark.astro';

interface Props {
    data: FooterData;
}

const {
    logoLabel,
    logoHref,
    tagline,
    links,
    cta,
    ctaNote,
    addressLabel,
    address,
    hoursLabel,
    hours,
    phoneLabel,
    phone,
    phoneHref,
    note,
} = Astro.props.data;
---

<footer class="footer">
    <div class="footer__inner">
        <div class="footer__top">
            <div class="footer__brand">
                <a class="footer__logo" href={logoHref} aria-label={logoLabel}>
                    <LogoMark label={logoLabel} />
                </a>
                <p class="footer__tagline">{tagline}</p>
            </div>
            <div class="footer__cta-wrap">
                <a class="footer__cta" href={cta.href}>{cta.label}</a>
                <p class="footer__cta-note">{ctaNote}</p>
            </div>
        </div>
        <div class="footer__grid">
            <nav class="footer__nav" aria-label="Разделы">
                <ul class="footer__links">
                    {
                        links.map((link) => (
                            <li>
                                <a class="footer__link" href={link.href}>
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
            <dl class="footer__facts">
                <div class="footer__fact">
                    <dt class="footer__fact-label">{addressLabel}</dt>
                    <dd class="footer__fact-value">{address}</dd>
                </div>
                <div class="footer__fact">
                    <dt class="footer__fact-label">{phoneLabel}</dt>
                    <dd class="footer__fact-value">
                        <a class="footer__fact-link" href={phoneHref}>{phone}</a>
                    </dd>
                </div>
            </dl>
            <dl class="footer__facts">
                <div class="footer__fact">
                    <dt class="footer__fact-label">{hoursLabel}</dt>
                    <dd class="footer__fact-value">{hours}</dd>
                </div>
            </dl>
        </div>
        <p class="footer__note">{note}</p>
    </div>
</footer>

<style lang="scss">
    .footer {
        background-color: var(--color-surface);
        border-top: 0.1rem solid var(--color-border);
        color: var(--color-text);
    }

    .footer__inner {
        width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
        margin-inline: auto;
        padding: 8rem var(--page-gutter) 4rem;
    }

    .footer__top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 6.4rem;
        padding-bottom: 6.4rem;
    }

    .footer__brand {
        display: flex;
        flex-direction: column;
        gap: 2.4rem;
        max-width: 46rem;
    }

    .footer__logo {
        display: inline-flex;
        color: inherit;
        text-decoration: none;
    }

    .footer__tagline {
        margin: 0;
        font-size: 1.6rem;
        line-height: 1.5;
        color: color-mix(in srgb, var(--color-text) 64%, transparent);
    }

    .footer__cta-wrap {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 1.2rem;
    }

    .footer__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 5.6rem;
        padding: 1.2rem 3.6rem;
        border-radius: 4.8rem;
        background-color: var(--color-accent);
        color: var(--color-background);
        font-size: 1.8rem;
        line-height: 1.2;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;

        &:hover {
            background-color: var(--color-text);
            color: var(--color-background);
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    .footer__cta-note {
        margin: 0;
        max-width: 26rem;
        font-size: 1.4rem;
        line-height: 1.4;
        text-align: right;
        text-wrap: pretty;
        color: color-mix(in srgb, var(--color-text) 64%, transparent);
    }

    .footer__grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: 4.8rem;
        padding-top: 5.6rem;
        border-top: 0.1rem solid var(--color-border);
    }

    .footer__links {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .footer__link {
        font-size: 1.8rem;
        line-height: 1.3;
        text-decoration: none;
        transition: color 0.2s ease;

        &:hover {
            color: var(--color-secondary-text);
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    .footer__facts {
        display: flex;
        flex-direction: column;
        gap: 2.4rem;
    }

    .footer__fact-label {
        margin-bottom: 0.8rem;
        font-size: 1.4rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-secondary-text);
    }

    .footer__fact-value {
        margin: 0;
        font-size: 1.8rem;
        line-height: 1.35;
    }

    .footer__fact-link {
        text-decoration: none;
        transition: color 0.2s ease;

        &:hover {
            text-decoration: underline;
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    .footer__note {
        margin: 6.4rem 0 0;
        padding-top: 3.2rem;
        border-top: 0.1rem solid var(--color-border);
        font-size: 1.4rem;
        color: color-mix(in srgb, var(--color-text) 64%, transparent);
    }
</style>