---
import type { FooterData } from '#/types/footer';

interface Props {
	data: FooterData;
}

const { name, city, address, phoneLabel, phoneHref, hours } = Astro.props.data;
---

<footer class="footer-masthead">
	<div class="footer-masthead__inner">
		<p class="footer-masthead__name">{name}</p>
		<div class="footer-masthead__meta">
			<address class="footer-masthead__contacts">
				<p class="footer-masthead__place">{city}, {address}</p>
				<a class="footer-masthead__phone" href={phoneHref}>{phoneLabel}</a>
			</address>
			<p class="footer-masthead__hours">{hours}</p>
		</div>
	</div>
</footer>

<style lang="scss">
	.footer-masthead {
		background-color: var(--color-background);
	}

	.footer-masthead__inner {
		width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
		margin-inline: auto;
		padding: 9.6rem var(--page-gutter) 6.4rem;
	}

	.footer-masthead__name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 6.4rem;
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.footer-masthead__meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 2.4rem 4.8rem;
		margin-top: 4.8rem;
	}

	.footer-masthead__contacts {
		margin: 0;
		font-style: normal;
	}

	.footer-masthead__place {
		margin: 0;
		font-size: 1.8rem;
		line-height: 1.5;
	}

	.footer-masthead__phone {
		display: inline-block;
		margin-top: 1rem;
		font-size: 1.8rem;
		line-height: 1.5;
		color: var(--color-accent);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-underline-offset: 0.4rem;
		}

		&:focus-visible {
			outline: 0.2rem solid var(--color-text);
			outline-offset: 0.4rem;
		}
	}

	.footer-masthead__hours {
		margin: 0;
		font-size: 1.8rem;
		line-height: 1.5;
		color: var(--color-secondary-text);
	}
</style>