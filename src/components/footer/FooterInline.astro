---
import type { FooterData } from '#/types/footer';

interface Props {
	data: FooterData;
}

const { name, city, address, phoneLabel, phoneHref, hours } = Astro.props.data;
---

<footer class="footer-inline">
	<div class="footer-inline__inner">
		<address class="footer-inline__contacts">
			<span class="footer-inline__name">{name}</span>
			<span class="footer-inline__sep" aria-hidden="true">·</span>
			<span class="footer-inline__place">{city}, {address}</span>
			<span class="footer-inline__sep" aria-hidden="true">·</span>
			<a class="footer-inline__phone" href={phoneHref}>{phoneLabel}</a>
		</address>
		<p class="footer-inline__hours">{hours}</p>
	</div>
</footer>

<style lang="scss">
	.footer-inline {
		background-color: var(--color-background);
		border-top: 0.1rem solid var(--color-border);
	}

	.footer-inline__inner {
		width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
		margin-inline: auto;
		padding: 3.2rem var(--page-gutter);
	}

	.footer-inline__contacts {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.8rem 1.6rem;
		margin: 0;
		font-style: normal;
	}

	.footer-inline__name {
		font-family: var(--font-display);
		font-size: 2.2rem;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.footer-inline__sep {
		color: var(--color-secondary-text);
	}

	.footer-inline__place {
		font-size: 1.8rem;
		line-height: 1.5;
	}

	.footer-inline__phone {
		font-size: 1.8rem;
		line-height: 1.5;
		color: var(--color-accent);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-underline-offset: 0.4rem;
		}

		&:focus-visible {
			outline: 0.2rem solid var(--color-text);
			outline-offset: 0.4rem;
		}
	}

	.footer-inline__hours {
		margin: 1rem 0 0;
		font-size: 1.6rem;
		line-height: 1.5;
		color: var(--color-secondary-text);
	}
</style>