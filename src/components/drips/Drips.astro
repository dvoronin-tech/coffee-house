---
import type { DripsData } from '#/types/drips';

interface Props {
    data: DripsData;
}

const { title, composition, count, price, note, linkLabel, linkHref } =
    Astro.props.data;
---

<section id="drips" class="drips" aria-labelledby="drips-title">
    <div class="drips__inner">
        <div class="drips__band">
            <h2 id="drips-title" class="drips__title">{title}</h2>
            <p class="drips__meta">{composition}, {count}</p>
            <p class="drips__note">{note}</p>
            <div class="drips__order">
                <p class="drips__price">{price}</p>
                <a class="drips__link" href={linkHref}>{linkLabel}</a>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    @keyframes drips-rise {
        from {
            opacity: 0;
            transform: translateY(4.8rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @mixin rise($range) {
        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: drips-rise auto linear both;
                animation-timeline: view();
                animation-range: #{$range};
            }
        }
    }

    .drips {
        background: var(--color-background);
        color: var(--color-text);
        padding: 9.6rem var(--page-gutter);
    }

    .drips__inner {
        max-width: var(--page-width);
        margin: 0 auto;
    }

    .drips__band {
        display: flex;
        align-items: center;
        padding: 3.6rem 4.8rem;
        background: var(--color-surface);
        border: 0.1rem solid var(--color-border);
        border-radius: 4.8rem 0 4.8rem 4.8rem;

        @include rise('cover 1% cover 20%');

        & > * + * {
            padding-left: 4.8rem;
            margin-left: 4.8rem;
            border-left: 0.1rem solid var(--color-border);
        }
    }

    .drips__title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 3.2rem;
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.02em;
        white-space: nowrap;
    }

    .drips__meta {
        margin: 0;
        font-size: 1.8rem;
        line-height: 1.4;
        white-space: nowrap;
    }

    .drips__note {
        flex: 1;
        margin: 0;
        max-width: 40rem;
        font-size: 1.6rem;
        line-height: 1.45;
        color: var(--color-secondary-text);
    }

    .drips__order {
        display: flex;
        align-items: baseline;
        gap: 2.4rem;
    }

    .drips__price {
        margin: 0;
        font-family: var(--font-display);
        font-size: 3.6rem;
        line-height: 1;
        letter-spacing: -0.02em;
        white-space: nowrap;
    }

    .drips__link {
        font-size: 1.8rem;
        line-height: 1.2;
        text-decoration: underline;
        text-underline-offset: 0.6rem;
        text-decoration-thickness: 0.1rem;
        transition: color 0.2s ease;

        &:hover {
            color: var(--color-accent);
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .drips__band {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
