---
import type { SubscriptionData } from '#/types/subscription';

interface Props {
    data: SubscriptionData;
}

const { title, facts, ctaLabel, ctaHref, note } = Astro.props.data;
---

<section id="subscribe" class="subscription" aria-labelledby="subscription-title">
    <div class="subscription__inner">
        <div class="subscription__block">
            <h2 id="subscription-title" class="subscription__title">
                {title}
            </h2>
            <ul class="subscription__facts">
                {
                    facts.map((fact) => (
                        <li class="subscription__fact">
                            <span class="subscription__fact-value">
                                {fact.value}
                            </span>
                            <span class="subscription__fact-detail">
                                {fact.detail}
                            </span>
                        </li>
                    ))
                }
            </ul>
            <a class="subscription__cta" href={ctaHref}>{ctaLabel}</a>
            <p class="subscription__note">{note}</p>
        </div>
    </div>
</section>

<style lang="scss">
    @keyframes subscription-rise {
        from {
            opacity: 0;
            transform: translateY(4.8rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .subscription {
        background-color: var(--color-background);
        color: var(--color-text);
        padding: 9.6rem var(--page-gutter);
    }

    .subscription__inner {
        max-width: var(--page-width);
        margin: 0 auto;
    }

    .subscription__block {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: min(100%, 80rem);
        margin: 0 auto;
        padding: 8rem 7.2rem;
        background-color: var(--color-accent);
        border-radius: 4.8rem 0 4.8rem 4.8rem;
        text-align: center;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: view();
                animation-range: cover 5% cover 35%;
            }
        }
    }

    .subscription__title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 5.2rem;
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.02em;
        text-wrap: balance;
    }

    .subscription__facts {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
        margin: 4.8rem 0 0;
        padding: 0;
        list-style: none;
    }

    .subscription__fact {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 1.2rem;
    }

    .subscription__fact-value {
        font-family: var(--font-display);
        font-size: 2.4rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .subscription__fact-detail {
        font-size: 1.8rem;
        line-height: 1.35;
        color: color-mix(in srgb, var(--color-text) 72%, transparent);
    }

    .subscription__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 4.4rem;
        margin-top: 4.8rem;
        padding: 0.8rem 2.8rem;
        border-radius: 4.8rem;
        background-color: var(--color-background);
        color: var(--color-text);
        font-size: 1.8rem;
        line-height: 1.2;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;

        &:hover {
            background-color: var(--color-text);
            color: var(--color-background);
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    .subscription__note {
        margin: 2.4rem 0 0;
        max-width: 32rem;
        font-size: 1.4rem;
        line-height: 1.4;
        text-wrap: pretty;
        color: color-mix(in srgb, var(--color-text) 64%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
        .subscription__block {
            animation: none;
            opacity: 1;
            transform: none;
        }

        .subscription__cta {
            transition: none;
        }
    }
</style>