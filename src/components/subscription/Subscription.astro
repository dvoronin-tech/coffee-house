---
import type { SubscriptionData } from '#/types/subscription';

interface Props {
    data: SubscriptionData;
}

const { title, price, facts, ctaLabel, ctaHref, note } = Astro.props.data;
---

<section id="subscribe" class="subscription" aria-labelledby="subscription-title">
    <div class="subscription__inner">
        <div class="subscription__info">
            <h2 id="subscription-title" class="subscription__title">
                {title}
            </h2>
            <ul class="subscription__facts">
                {
                    facts.map((fact) => (
                        <li class="subscription__fact">
                            <span class="subscription__fact-value">
                                {fact.value}
                            </span>
                            <span class="subscription__fact-detail">
                                {fact.detail}
                            </span>
                        </li>
                    ))
                }
            </ul>
            <div class="subscription__actions">
                <a class="subscription__cta" href={ctaHref}>{ctaLabel}</a>
                <p class="subscription__note">{note}</p>
            </div>
        </div>
        <p class="subscription__price">
            <span class="subscription__price-amount">{price.amount}</span>
            <span class="subscription__price-side">
                <span class="subscription__price-currency">
                    {price.currency}
                </span>
                <span class="subscription__price-period">{price.period}</span>
            </span>
        </p>
    </div>
</section>

<style lang="scss">
    @keyframes subscription-rise {
        from {
            opacity: 0;
            transform: translateY(4.8rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .subscription {
        background-color: var(--color-background);
        color: var(--color-text);
        padding: 12rem var(--page-gutter);

        @supports (animation-timeline: view()) {
            view-timeline-name: --subscription;
            view-timeline-axis: block;
        }
    }

    .subscription__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 6.4rem;
        align-items: center;
        max-width: var(--page-width);
        margin: 0 auto;
    }

    .subscription__info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .subscription__title {
        margin: 0;
        max-width: 44rem;
        font-family: var(--font-display);
        font-size: 4.8rem;
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.02em;
        text-wrap: balance;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 2% cover 22%;
            }
        }
    }

    .subscription__facts {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
        margin: 3.2rem 0 0;
        padding: 0;
        list-style: none;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 8% cover 26%;
            }
        }
    }

    .subscription__fact {
        display: flex;
        align-items: baseline;
        gap: 1.2rem;
    }

    .subscription__fact-value {
        font-family: var(--font-display);
        font-size: 2.4rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .subscription__fact-detail {
        font-size: 1.8rem;
        line-height: 1.35;
        color: var(--color-secondary-text);
    }

    .subscription__actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2rem;
        margin-top: 4.8rem;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 12% cover 30%;
            }
        }
    }

    .subscription__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 4.4rem;
        padding: 0.8rem 2.8rem;
        border-radius: 4.8rem;
        background-color: var(--color-accent);
        color: var(--color-text);
        font-size: 1.8rem;
        line-height: 1.2;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;

        &:hover {
            background-color: var(--color-text);
            color: var(--color-background);
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    .subscription__note {
        margin: 0;
        max-width: 26rem;
        font-size: 1.4rem;
        line-height: 1.4;
        text-wrap: pretty;
        color: var(--color-secondary-text);
    }

    .subscription__price {
        display: flex;
        align-items: flex-start;
        gap: 1.6rem;
        justify-self: end;
        margin: 0;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 4% cover 24%;
            }
        }
    }

    .subscription__price-amount {
        font-family: var(--font-display);
        font-size: 14rem;
        font-weight: 400;
        line-height: 0.9;
        letter-spacing: -0.02em;
        color: var(--color-accent);
    }

    .subscription__price-side {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        padding-top: 1.6rem;
    }

    .subscription__price-currency {
        font-family: var(--font-display);
        font-size: 2.8rem;
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .subscription__price-period {
        font-size: 1.8rem;
        line-height: 1.3;
        color: var(--color-secondary-text);
    }

    @media (prefers-reduced-motion: reduce) {
        .subscription__title,
        .subscription__facts,
        .subscription__actions,
        .subscription__price {
            animation: none;
            opacity: 1;
            transform: none;
        }

        .subscription__cta {
            transition: none;
        }
    }
</style>