---
import type { SubscriptionData } from '#/types/subscription';

interface Props {
    data: SubscriptionData;
}

const { title, facts, ctaLabel, ctaHref, note } = Astro.props.data;
---

<section id="subscribe" class="subscription" aria-labelledby="subscription-title">
    <div class="subscription__inner">
        <h2 id="subscription-title" class="subscription__title">
            {title}
        </h2>
        <div class="subscription__rule" aria-hidden="true"></div>
        <ul class="subscription__facts">
            {
                facts.map((fact) => (
                    <li class="subscription__fact">
                        <span class="subscription__fact-value">
                            {fact.value}
                        </span>
                        <span class="subscription__fact-detail">
                            {fact.detail}
                        </span>
                    </li>
                ))
            }
        </ul>
        <div class="subscription__actions">
            <a class="subscription__cta" href={ctaHref}>{ctaLabel}</a>
            <p class="subscription__note">{note}</p>
        </div>
    </div>
</section>

<style lang="scss">
    @keyframes subscription-rise {
        from {
            opacity: 0;
            transform: translateY(4.8rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .subscription {
        background-color: var(--color-background);
        color: var(--color-text);
        padding: 12rem var(--page-gutter);

        @supports (animation-timeline: view()) {
            view-timeline-name: --subscription;
            view-timeline-axis: block;
        }
    }

    .subscription__inner {
        max-width: var(--page-width);
        margin: 0 auto;
    }

    .subscription__title {
        margin: 0;
        max-width: 96rem;
        font-family: var(--font-display);
        font-size: 7.2rem;
        font-weight: 400;
        line-height: 1.06;
        letter-spacing: -0.02em;
        text-wrap: balance;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 2% cover 22%;
            }
        }
    }

    .subscription__rule {
        width: 14rem;
        height: 0.4rem;
        margin-top: 4rem;
        background-color: var(--color-accent);

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 8% cover 26%;
            }
        }
    }

    .subscription__facts {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 1.6rem 4.8rem;
        margin: 4.8rem 0 0;
        padding: 0;
        list-style: none;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 12% cover 30%;
            }
        }
    }

    .subscription__fact {
        display: flex;
        align-items: baseline;
        gap: 1.2rem;
    }

    .subscription__fact-value {
        font-family: var(--font-display);
        font-size: 2.8rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .subscription__fact-detail {
        font-size: 1.8rem;
        line-height: 1.35;
        color: color-mix(in srgb, var(--color-text) 72%, transparent);
    }

    .subscription__actions {
        display: flex;
        align-items: center;
        gap: 2.4rem;
        margin-top: 5.6rem;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 14% cover 34%;
            }
        }
    }

    .subscription__cta {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 4.4rem;
        padding: 0.8rem 2.8rem;
        border-radius: 4.8rem;
        background-color: var(--color-accent);
        color: var(--color-text);
        font-size: 1.8rem;
        line-height: 1.2;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;

        &:hover {
            background-color: var(--color-text);
            color: var(--color-background);
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    .subscription__note {
        margin: 0;
        max-width: 26rem;
        font-size: 1.4rem;
        line-height: 1.4;
        text-wrap: pretty;
        color: var(--color-secondary-text);
    }

    @media (prefers-reduced-motion: reduce) {
        .subscription__title,
        .subscription__rule,
        .subscription__facts,
        .subscription__actions {
            animation: none;
            opacity: 1;
            transform: none;
        }

        .subscription__cta {
            transition: none;
        }
    }
</style>