---
import type { SubscriptionData } from '#/types/subscription';

interface Props {
    data: SubscriptionData;
}

const { title, price, facts, ctaLabel, ctaHref, note } = Astro.props.data;
---

<section id="subscribe" class="subscription" aria-labelledby="subscription-title">
    <div class="subscription__band">
        <h2 id="subscription-title" class="subscription__title">
            {title}
        </h2>
        <div class="subscription__bottom">
            <p class="subscription__price">
                <span class="subscription__price-amount">{price.amount}</span>
                <span class="subscription__price-side">
                    <span class="subscription__price-currency">
                        {price.currency}
                    </span>
                    <span class="subscription__price-period">
                        {price.period}
                    </span>
                </span>
            </p>
            <ul class="subscription__facts">
                {
                    facts.map((fact) => (
                        <li class="subscription__fact">
                            <span class="subscription__fact-value">
                                {fact.value}
                            </span>
                            <span class="subscription__fact-detail">
                                {fact.detail}
                            </span>
                        </li>
                    ))
                }
            </ul>
            <div class="subscription__actions">
                <a class="subscription__cta" href={ctaHref}>{ctaLabel}</a>
                <p class="subscription__note">{note}</p>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    @keyframes subscription-rise {
        from {
            opacity: 0;
            transform: translateY(6.4rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .subscription {
        position: relative;
        isolation: isolate;
        color: var(--color-text);

        @supports (animation-timeline: view()) {
            view-timeline-name: --subscription;
            view-timeline-axis: block;
        }
    }

    .subscription::before {
        content: '';
        position: absolute;
        z-index: -1;
        inset: 0;
        background-color: var(--color-accent);

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-card auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 55% cover 80%;
            }
        }
    }

    .subscription__band {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 8rem;
        min-height: 100vh;
        min-height: 100svh;
        width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
        margin-inline: auto;
        padding: 14rem var(--page-gutter) 8rem;

        @media (prefers-reduced-motion: no-preference) and (min-width: 1280px) {
            @supports (animation-timeline: view()) {
                animation: subscription-inset auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 55% cover 80%;
            }
        }
    }

    .subscription__title {
        margin: 0;
        max-width: 92rem;
        font-family: var(--font-display);
        font-size: 12rem;
        font-weight: 400;
        line-height: 1.04;
        letter-spacing: -0.02em;
        text-wrap: balance;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 2% cover 22%;
            }
        }
    }

    .subscription__bottom {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 6.4rem;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: --subscription;
                animation-range: cover 8% cover 32%;
            }
        }
    }

    .subscription__price {
        display: flex;
        align-items: flex-start;
        gap: 1.6rem;
        margin: 0;
    }

    .subscription__price-amount {
        font-family: var(--font-display);
        font-size: 20rem;
        font-weight: 400;
        line-height: 0.85;
        letter-spacing: -0.02em;
    }

    .subscription__price-side {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        padding-top: 2.4rem;
    }

    .subscription__price-currency {
        font-family: var(--font-display);
        font-size: 3.2rem;
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .subscription__price-period {
        font-size: 2rem;
        line-height: 1.3;
        color: color-mix(in srgb, var(--color-text) 64%, transparent);
    }

    .subscription__facts {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .subscription__fact {
        display: flex;
        align-items: baseline;
        gap: 1.2rem;
    }

    .subscription__fact-value {
        font-family: var(--font-display);
        font-size: 3rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .subscription__fact-detail {
        font-size: 2rem;
        line-height: 1.35;
        color: color-mix(in srgb, var(--color-text) 72%, transparent);
    }

    .subscription__actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 2rem;
    }

    .subscription__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 4.4rem;
        padding: 0.8rem 2.8rem;
        border-radius: 4.8rem;
        background-color: var(--color-background);
        color: var(--color-text);
        font-size: 1.8rem;
        line-height: 1.2;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;

        &:hover {
            background-color: var(--color-text);
            color: var(--color-background);
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    .subscription__note {
        margin: 0;
        max-width: 26rem;
        font-size: 1.4rem;
        line-height: 1.4;
        text-align: right;
        text-wrap: pretty;
        color: color-mix(in srgb, var(--color-text) 64%, transparent);
    }

    @keyframes subscription-card {
        to {
            inset-inline: calc(
                var(--page-gutter) +
                    max(
                        (100% - var(--page-width) - 2 * var(--page-gutter)) / 2,
                        0rem
                    )
            );
            border-radius: 4.8rem 0 4.8rem 4.8rem;
        }
    }

    @keyframes subscription-inset {
        to {
            padding-inline: calc(var(--page-gutter) * 2);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .subscription::before,
        .subscription__band {
            animation: none;
        }

        .subscription__title,
        .subscription__bottom {
            animation: none;
            opacity: 1;
            transform: none;
        }

        .subscription__cta {
            transition: none;
        }
    }
</style>