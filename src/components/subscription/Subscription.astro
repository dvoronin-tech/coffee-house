---
import type { SubscriptionData } from '#/types/subscription';

interface Props {
    data: SubscriptionData;
}

const { title, facts, ctaLabel, ctaHref, note } = Astro.props.data;
---

<section id="subscribe" class="subscription" aria-labelledby="subscription-title">
    <div class="subscription__band">
        <h2 id="subscription-title" class="subscription__title">
            {title}
        </h2>
        <div class="subscription__bottom">
            <ul class="subscription__facts">
                {
                    facts.map((fact) => (
                        <li class="subscription__fact">
                            <span class="subscription__fact-value">
                                {fact.value}
                            </span>
                            <span class="subscription__fact-detail">
                                {fact.detail}
                            </span>
                        </li>
                    ))
                }
            </ul>
            <div class="subscription__actions">
                <a class="subscription__cta" href={ctaHref}>{ctaLabel}</a>
                <p class="subscription__note">{note}</p>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    @keyframes subscription-rise {
        from {
            opacity: 0;
            transform: translateY(6.4rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .subscription {
        background-color: var(--color-accent);
        color: var(--color-text);
    }

    .subscription__band {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 8rem;
        min-height: 100svh;
        width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
        margin-inline: auto;
        padding: 14rem var(--page-gutter) 8rem;
    }

    .subscription__title {
        margin: 0;
        max-width: 96rem;
        font-family: var(--font-display);
        font-size: 12rem;
        font-weight: 400;
        line-height: 1.04;
        letter-spacing: -0.02em;
        text-wrap: balance;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: view();
                animation-range: cover 0% cover 30%;
            }
        }
    }

    .subscription__bottom {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 6.4rem;

        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: subscription-rise auto linear both;
                animation-timeline: view();
                animation-range: cover 8% cover 38%;
            }
        }
    }

    .subscription__facts {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .subscription__fact {
        display: flex;
        align-items: baseline;
        gap: 1.2rem;
    }

    .subscription__fact-value {
        font-family: var(--font-display);
        font-size: 3.2rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .subscription__fact-detail {
        font-size: 2rem;
        line-height: 1.35;
        color: color-mix(in srgb, var(--color-text) 72%, transparent);
    }

    .subscription__actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 2rem;
    }

    .subscription__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 4.4rem;
        padding: 0.8rem 2.8rem;
        border-radius: 4.8rem;
        background-color: var(--color-background);
        color: var(--color-text);
        font-size: 1.8rem;
        line-height: 1.2;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;

        &:hover {
            background-color: var(--color-text);
            color: var(--color-background);
        }

        &:focus-visible {
            outline: 0.2rem solid var(--color-text);
            outline-offset: 0.4rem;
        }
    }

    .subscription__note {
        margin: 0;
        max-width: 28rem;
        font-size: 1.4rem;
        line-height: 1.4;
        text-align: right;
        text-wrap: pretty;
        color: color-mix(in srgb, var(--color-text) 64%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
        .subscription__title,
        .subscription__bottom {
            animation: none;
            opacity: 1;
            transform: none;
        }

        .subscription__cta {
            transition: none;
        }
    }
</style>