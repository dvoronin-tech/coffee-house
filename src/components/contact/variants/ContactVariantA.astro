---
import LeadForm from '#/components/contact/LeadForm';
import type { ContactData } from '#/types/contact';

interface Props {
    data: ContactData;
}

const { data } = Astro.props;
---

<section id="contact-a" class="contact" aria-labelledby="contact-a-title">
    <div class="contact__inner">
        <div class="contact__intro">
            <h2 id="contact-a-title" class="contact__title">{data.title}</h2>
            <p class="contact__lead">{data.lead}</p>
            <dl class="contact__list">
                <div class="contact__item">
                    <dt class="contact__label">{data.addressLabel}</dt>
                    <dd class="contact__value">{data.address}</dd>
                </div>
                <div class="contact__item">
                    <dt class="contact__label">{data.hoursLabel}</dt>
                    <dd class="contact__value">{data.hours}</dd>
                </div>
                <div class="contact__item">
                    <dt class="contact__label">{data.phoneLabel}</dt>
                    <dd class="contact__value">
                        <a class="contact__phone" href={data.phoneHref}>
                            {data.phone}
                        </a>
                    </dd>
                </div>
            </dl>
        </div>
        <div class="contact__form" id="contact-form">
            <p class="contact__kicker">{data.formKicker}</p>
            <LeadForm client:visible variant="card" data={data} />
        </div>
    </div>
</section>

<style lang="scss">
    @keyframes contact-a-rise {
        from {
            opacity: 0;
            transform: translateY(3rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @mixin rise($range) {
        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: contact-a-rise auto linear both;
                animation-timeline: view();
                animation-range: #{$range};
            }
        }
    }

    .contact {
        padding: 12rem var(--page-gutter);
        background-color: var(--color-text);
        color: var(--color-background);
    }

    .contact__inner {
        max-width: var(--page-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        column-gap: 8rem;
        align-items: start;
    }

    .contact__title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 4.8rem;
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.02em;
        text-wrap: balance;

        @include rise('cover 8% cover 26%');
    }

    .contact__lead {
        margin: 2rem 0 0;
        max-width: 38rem;
        font-size: 1.8rem;
        line-height: 1.55;
        color: color-mix(
            in srgb,
            var(--color-background) 74%,
            var(--color-text)
        );

        @include rise('cover 12% cover 30%');
    }

    .contact__list {
        margin: 4.8rem 0 0;

        @include rise('cover 16% cover 34%');
    }

    .contact__item {
        display: grid;
        gap: 0.5rem;
        padding-block: 1.9rem;
        border-top: 0.1rem solid
            color-mix(in srgb, var(--color-border) 28%, transparent);

        &:last-child {
            border-bottom: 0.1rem solid
                color-mix(in srgb, var(--color-border) 28%, transparent);
        }
    }

    .contact__label {
        color: color-mix(
            in srgb,
            var(--color-background) 58%,
            var(--color-text)
        );
        font-size: 1.4rem;
        line-height: 1.3;
    }

    .contact__value {
        margin: 0;
        font-size: 1.8rem;
        line-height: 1.4;
    }

    .contact__phone {
        font-size: 2rem;
        color: var(--color-accent);
        text-decoration: none;

        &:hover {
            text-decoration: underline;
            text-underline-offset: 0.4rem;
        }
    }

    .contact__form {
        padding: 4.8rem;
        background-color: var(--color-surface);
        color: var(--color-text);
        border-radius: 4.8rem 0 4.8rem 4.8rem;
        box-shadow: 0 3.2rem 6.4rem color-mix(in srgb, #000 28%, transparent);

        @include rise('cover 10% cover 30%');
    }

    .contact__kicker {
        margin: 0 0 2.8rem;
        font-size: 1.3rem;
        line-height: 1.3;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--color-secondary-text);
    }

    @media (prefers-reduced-motion: reduce) {
        .contact__title,
        .contact__lead,
        .contact__list,
        .contact__form {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
</style>