---
import LeadForm from '#/components/contact/LeadForm';
import type { ContactData } from '#/types/contact';

interface Props {
    data: ContactData;
}

const { data } = Astro.props;
---

<section id="contact-b" class="contact" aria-labelledby="contact-b-title">
    <div class="contact__inner">
        <div class="contact__intro">
            <h2 id="contact-b-title" class="contact__title">{data.title}</h2>
            <p class="contact__lead">{data.lead}</p>
            <dl class="contact__list">
                <div class="contact__item">
                    <dt class="contact__label">{data.addressLabel}</dt>
                    <dd class="contact__value">{data.address}</dd>
                </div>
                <div class="contact__item">
                    <dt class="contact__label">{data.hoursLabel}</dt>
                    <dd class="contact__value">{data.hours}</dd>
                </div>
                <div class="contact__item">
                    <dt class="contact__label">{data.phoneLabel}</dt>
                    <dd class="contact__value">
                        <a class="contact__phone" href={data.phoneHref}>
                            {data.phone}
                        </a>
                    </dd>
                </div>
            </dl>
        </div>
        <div class="contact__form" id="contact-form-b">
            <p class="contact__kicker">{data.formKicker}</p>
            <LeadForm client:visible variant="editorial" data={data} />
        </div>
    </div>
</section>

<style lang="scss">
    @keyframes contact-b-rise {
        from {
            opacity: 0;
            transform: translateY(3rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @mixin rise($range) {
        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: contact-b-rise auto linear both;
                animation-timeline: view();
                animation-range: #{$range};
            }
        }
    }

    .contact {
        padding: 14rem var(--page-gutter);
        background-color: var(--color-text);
        color: var(--color-background);
    }

    .contact__inner {
        max-width: var(--page-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        column-gap: 10rem;
        align-items: start;
    }

    .contact__title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 6.4rem;
        font-weight: 400;
        line-height: 1.04;
        letter-spacing: -0.02em;
        text-wrap: balance;

        @include rise('cover 8% cover 26%');
    }

    .contact__lead {
        margin: 2.4rem 0 0;
        max-width: 44rem;
        font-size: 2rem;
        line-height: 1.5;
        color: color-mix(
            in srgb,
            var(--color-background) 70%,
            var(--color-text)
        );

        @include rise('cover 12% cover 30%');
    }

    .contact__list {
        margin: 6.4rem 0 0;
        display: grid;
        gap: 3.2rem;

        @include rise('cover 16% cover 34%');
    }

    .contact__item {
        display: grid;
        gap: 0.7rem;
    }

    .contact__label {
        font-size: 1.2rem;
        line-height: 1.3;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: color-mix(
            in srgb,
            var(--color-background) 56%,
            var(--color-text)
        );
    }

    .contact__value {
        margin: 0;
        font-size: 1.8rem;
        line-height: 1.4;
    }

    .contact__phone {
        font-family: var(--font-display);
        font-size: 2.8rem;
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--color-accent);
        text-decoration: none;

        &:hover {
            text-decoration: underline;
            text-underline-offset: 0.5rem;
        }
    }

    .contact__kicker {
        margin: 0 0 3.2rem;
        font-size: 1.3rem;
        line-height: 1.3;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--color-accent);

        @include rise('cover 10% cover 28%');
    }

    .contact__form {
        @include rise('cover 10% cover 30%');
    }

    @media (prefers-reduced-motion: reduce) {
        .contact__title,
        .contact__lead,
        .contact__list,
        .contact__kicker,
        .contact__form {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
</style>