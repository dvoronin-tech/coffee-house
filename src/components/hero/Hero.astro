---
import clsx from 'clsx';
import heroPhoto from '../../assets/hero-scoop.webp';
import styles from './Hero.module.scss';
---

<section class={styles.hero} aria-labelledby="hero-title">
	<div class={styles['hero__inner']}>
		<div class={styles['hero__top']}>
			<div class={styles['hero__intro']}>
				<h1 id="hero-title" class={styles['hero__title']}>Кварта</h1>
				<p class={styles['hero__lead']}>
					Зерно оказывается у вас на 1–3 день после обжарки.
				</p>
				<p class={styles['hero__text']}>
					Мастерская в Минске. Жарим небольшими партиями и отдаём
					зерно, пока оно свежее.
				</p>
				<div class={styles['hero__links']}>
					<a
						class={clsx(styles['hero__link'], styles['hero__link--primary'])}
						href="#grain"
					>
						Выбрать зерно
					</a>
					<a
						class={clsx(styles['hero__link'], styles['hero__link--secondary'])}
						href="#subscribe"
					>
						Подписка
					</a>
				</div>
			</div>
			<dl class={styles['hero__meta']}>
				<div class={styles['hero__meta-item']}>
					<dt class={styles['hero__meta-label']}>Город</dt>
					<dd class={styles['hero__meta-value']}>Минск</dd>
				</div>
				<div class={styles['hero__meta-item']}>
					<dt class={styles['hero__meta-label']}>Мастерская</dt>
					<dd class={styles['hero__meta-value']}>с&nbsp;2019</dd>
				</div>
				<div class={styles['hero__meta-item']}>
					<dt class={styles['hero__meta-label']}>Партии</dt>
					<dd class={styles['hero__meta-value']}>по&nbsp;5&nbsp;кг</dd>
				</div>
				<div class={styles['hero__meta-item']}>
					<dt class={styles['hero__meta-label']}>Обжарка</dt>
					<dd class={styles['hero__meta-value']}>по&nbsp;четвергам</dd>
				</div>
			</dl>
		</div>
		<div class={styles['hero__frame']}>
			<img
				class={styles['hero__media']}
				src={heroPhoto.src}
				width={heroPhoto.width}
				height={heroPhoto.height}
				alt="Рука держит совок с кофейным зерном"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>
