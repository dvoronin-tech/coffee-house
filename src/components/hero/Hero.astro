---
import heroPhoto from '../../assets/hero-scoop.webp';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__inner">
		<div class="hero__top">
			<div class="hero__intro">
				<h1 id="hero-title" class="hero__title">Кварта</h1>
				<p class="hero__lead">
					Зерно оказывается у вас на 1–3 день после обжарки.
				</p>
				<p class="hero__text">
					Мастерская в Минске. Жарим небольшими партиями и отдаём
					зерно, пока оно свежее.
				</p>
				<div class="hero__links">
					<a class="hero__link hero__link--primary" href="#grain">
						Выбрать зерно
					</a>
					<a class="hero__link hero__link--secondary" href="#subscribe">
						Подписка
					</a>
				</div>
			</div>
			<dl class="hero__meta">
				<div class="hero__meta-item">
					<dt class="hero__meta-label">Город</dt>
					<dd class="hero__meta-value">Минск</dd>
				</div>
				<div class="hero__meta-item">
					<dt class="hero__meta-label">Мастерская</dt>
					<dd class="hero__meta-value">с&nbsp;2019</dd>
				</div>
				<div class="hero__meta-item">
					<dt class="hero__meta-label">Партии</dt>
					<dd class="hero__meta-value">по&nbsp;5&nbsp;кг</dd>
				</div>
				<div class="hero__meta-item">
					<dt class="hero__meta-label">Обжарка</dt>
					<dd class="hero__meta-value">по&nbsp;четвергам</dd>
				</div>
			</dl>
		</div>
		<div class="hero__frame">
			<img
				class="hero__media"
				src={heroPhoto.src}
				width={heroPhoto.width}
				height={heroPhoto.height}
				alt="Рука держит совок с кофейным зерном"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<style lang="scss">
	.hero {
		background-color: var(--color-cream);
	}

	.hero__inner {
		width: min(100%, calc(var(--page-width) + var(--page-gutter) * 2));
		margin-inline: auto;
		padding: 14rem var(--page-gutter) 8rem;
	}

	.hero__top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 28rem;
		column-gap: 6.4rem;
		align-items: stretch;
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 14rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.hero__lead {
		max-width: 52rem;
		margin: 2.8rem 0 0;
		font-size: 2.4rem;
		font-weight: 400;
		line-height: 1.35;
		text-wrap: balance;
	}

	.hero__text {
		max-width: 48rem;
		margin: 1.6rem 0 0;
		font-size: 1.8rem;
		line-height: 1.5;
		text-wrap: pretty;
	}

	.hero__links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem 1.6rem;
		margin-top: 3.2rem;
	}

	.hero__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 4.4rem;
		padding: 0.8rem 2.4rem;
		border: 0.1rem solid transparent;
		border-radius: 4.8rem;
		font-size: 1.8rem;
		line-height: 1.2;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;

		&:focus-visible {
			outline: 0.2rem solid var(--color-ink);
			outline-offset: 0.4rem;
		}
	}

	.hero__link--primary {
		background-color: var(--color-peach);
		border-color: var(--color-peach);
		color: var(--color-cream);

		&:hover {
			background-color: var(--color-ink);
			border-color: var(--color-ink);
			color: var(--color-cream);
		}
	}

	.hero__link--secondary {
		background-color: transparent;
		border-color: var(--color-ink);
		color: var(--color-ink);

		&:hover {
			background-color: var(--color-paper);
		}
	}

	.hero__meta {
		display: flex;
		flex-direction: column;
		align-self: start;
		margin: 0.4rem 0 0;
	}

	.hero__meta-item {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.6rem;
		padding-block: 1.6rem;

		& + & {
			border-top: 0.1rem solid var(--color-line);
		}
	}

	.hero__meta-label {
		margin: 0;
		color: var(--color-muted);
		font-size: 1.4rem;
		line-height: 1.3;
		white-space: nowrap;
	}

	.hero__meta-value {
		margin: 0;
		color: var(--color-ink);
		font-size: 1.8rem;
		line-height: 1.3;
		text-align: right;
		white-space: nowrap;
	}

	.hero__frame {
		position: relative;
		overflow: hidden;
		aspect-ratio: 3 / 2;
		margin-top: 7.2rem;
		border-radius: 4.8rem 0 4.8rem 4.8rem;
	}

	.hero__media {
		position: absolute;
		top: -12%;
		left: 0;
		width: 100%;
		height: 124%;
		max-width: none;
		object-fit: cover;
		object-position: center;
	}

	.hero__intro,
	.hero__meta {
		animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(3rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-parallax {
		from {
			transform: translateY(-4%);
		}

		to {
			transform: translateY(4%);
		}
	}

	@supports (animation-timeline: view()) {
		.hero__frame {
			view-timeline-name: --hero-frame;
			view-timeline-axis: block;
		}

		.hero__media {
			animation-name: hero-parallax;
			animation-duration: auto;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: --hero-frame;
			animation-range: cover 0% cover 100%;
		}
	}

	@media (max-width: 1280px) {
		.hero__inner {
			padding-top: 12rem;
		}

		.hero__title {
			font-size: 11.2rem;
		}
	}

	@media (max-width: 800px) {
		.hero__top {
			grid-template-columns: 1fr;
			row-gap: 4.8rem;
		}

		.hero__title {
			font-size: 7.2rem;
		}

		.hero__frame {
			max-height: 32rem;
			border-radius: 2.4rem 0 2.4rem 2.4rem;
		}
	}

	@media (max-width: 640px) {
		.hero__inner {
			padding-top: 8rem;
			padding-bottom: 4.8rem;
		}

		.hero__lead {
			font-size: 2rem;
		}

		.hero__text,
		.hero__link {
			font-size: 1.6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__intro,
		.hero__meta,
		.hero__media {
			animation: none;
			transform: none;
		}

		.hero__link {
			transition: none;
		}
	}
</style>
