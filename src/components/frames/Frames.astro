---
import { Picture } from 'astro:assets';
import type { FramesData } from '#/types/frames';

import grainPhoto from '#/assets/frames-grain.webp';
import roastPhoto from '#/assets/frames-roast.webp';
import dripPhoto from '#/assets/frames-drip.webp';

interface Props {
    data: FramesData;
}

const { frames } = Astro.props.data;

const sources = [grainPhoto, roastPhoto, dripPhoto];

const widths = [480, 800, 1600];
const sizes = `(min-width: 120rem) calc((var(--page-width) - var(--row-gap) * 2) / var(--frames-count)), calc((100vw - var(--page-gutter) * 2 - var(--row-gap) * 2) / var(--frames-count))`;
---

<section
    class='frames'
    aria-label='Три кадра из мастерской'
    style={`--frames-count: ${frames.length}`}
>
    <div class='frames__inner'>
        <ul class='frames__row'>
            {frames.map((frame, index) => (
                <li class:list={['frames__item', `frames__item--${index + 1}`]}>
                    <Picture
                        class='frames__media'
                        src={sources[index]}
                        formats={['avif', 'webp']}
                        fallbackFormat='webp'
                        widths={widths}
                        sizes={sizes}
                        alt={frame.alt}
                        loading='lazy'
                        decoding='async'
                    />
                </li>
            ))}
        </ul>
    </div>
</section>

<style lang='scss'>
    @keyframes frames-rise {
        from {
            opacity: 0;
            transform: translateY(4.8rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @mixin rise($range) {
        @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: view()) {
                animation: frames-rise auto linear both;
                animation-timeline: view();
                animation-range: #{$range};
            }
        }
    }

    .frames {
        --row-gap: 4.8rem;
        background-color: var(--color-background);
        color: var(--color-text);
        padding: 9.6rem var(--page-gutter);
    }

    .frames__inner {
        max-width: var(--page-width);
        margin: 0 auto;
    }

    .frames__row {
        display: flex;
        gap: var(--row-gap);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .frames__item {
        overflow: hidden;

        &:nth-child(1) {
            @include rise('cover 5% cover 25%');
        }

        &:nth-child(2) {
            @include rise('cover 12% cover 32%');
        }

        &:nth-child(3) {
            @include rise('cover 19% cover 39%');
        }
    }

    .frames__media {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;

        @media (hover: hover) {
            &:hover {
                transform: scale(1.05);
            }
        }
    }

    .frames__item--1 {
        border-radius: 9.6rem 2.4rem 2.4rem;
    }

    .frames__item--2 {
        border-radius: 2.4rem 9.6rem 2.4rem;
    }

    .frames__item--3 {
        border-radius: 2.4rem 2.4rem 9.6rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .frames__item {
            animation: none;
            opacity: 1;
            transform: none;
        }

        .frames__media {
            transition: none;
        }
    }

    @media (max-width: 1024px) {
        .frames {
            --row-gap: 2.4rem;
            padding: 6.4rem var(--page-gutter);
        }
    }

    @media (max-width: 768px) {
        .frames {
            padding: 4.8rem var(--page-gutter);
        }

        .frames__row {
            flex-direction: column;
        }

        .frames__item {
            height: 30rem;
            overflow: hidden;

            img {
                width: 100%;
                height: 100%;
            }
        }

        .frames__item--1,
        .frames__item--2,
        .frames__item--3 {
            border-radius: 2.4rem;
        }

        .frames__item:nth-child(n) {
            animation: none;
            animation-timeline: auto;
            opacity: 1;
            transform: none;
        }
    }

    @media (max-width: 480px) {
        .frames {
            --row-gap: 1.6rem;
            padding: 4.8rem var(--page-gutter);
        }
    }
</style>
