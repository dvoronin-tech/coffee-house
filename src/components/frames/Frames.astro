---
import type { FramesData } from '#/types/frames';

import grainLarge from '#/assets/frames-grain-1600.webp';
import grainMedium from '#/assets/frames-grain-800.webp';
import grainSmall from '#/assets/frames-grain-480.webp';
import roastLarge from '#/assets/frames-roast-1600.webp';
import roastMedium from '#/assets/frames-roast-800.webp';
import roastSmall from '#/assets/frames-roast-480.webp';
import dripLarge from '#/assets/frames-drip-1600.webp';
import dripMedium from '#/assets/frames-drip-800.webp';
import dripSmall from '#/assets/frames-drip-480.webp';

interface Props {
	data: FramesData;
}

const { frames } = Astro.props.data;

const sources = [
	{
		src: grainLarge,
		srcset: `${grainSmall.src} 480w, ${grainMedium.src} 800w, ${grainLarge.src} 1600w`,
	},
	{
		src: roastLarge,
		srcset: `${roastSmall.src} 480w, ${roastMedium.src} 800w, ${roastLarge.src} 1600w`,
	},
	{
		src: dripLarge,
		srcset: `${dripSmall.src} 480w, ${dripMedium.src} 800w, ${dripLarge.src} 1600w`,
	},
];
---

<section class="frames" aria-label="Три кадра из мастерской">
	<div class="frames__inner">
		<ul class="frames__row">
			{
				frames.map((frame, index) => (
					<li class:list={['frames__item', `frames__item--${index + 1}`]}>
						<div class="frames__frame">
							<img
								class="frames__media"
								src={sources[index].src.src}
								srcset={sources[index].srcset}
								sizes="(min-width: 120rem) 36.8rem, calc((100vw - var(--page-gutter) * 2 - 9.6rem) / 3)"
								width={sources[index].src.width}
								height={sources[index].src.height}
								alt={frame.alt}
								loading="lazy"
								decoding="async"
							/>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style lang="scss">
	@keyframes frames-rise {
		from {
			opacity: 0;
			transform: translateY(4.8rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@mixin rise($range) {
		@media (prefers-reduced-motion: no-preference) {
			@supports (animation-timeline: view()) {
				animation: frames-rise auto linear both;
				animation-timeline: view();
				animation-range: #{$range};
			}
		}
	}

	.frames {
		background-color: var(--color-background);
		color: var(--color-text);
		padding: 9.6rem var(--page-gutter);
	}

	.frames__inner {
		max-width: var(--page-width);
		margin: 0 auto;
	}

	.frames__row {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 4.8rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.frames__item {
		&:nth-child(1) {
			@include rise('cover 5% cover 25%');
		}

		&:nth-child(2) {
			@include rise('cover 12% cover 32%');
		}

		&:nth-child(3) {
			@include rise('cover 19% cover 39%');
		}
	}

	.frames__frame {
		overflow: hidden;
		aspect-ratio: 1 / 1;
		background-color: var(--color-surface);
	}

	.frames__media {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.frames__item--1 .frames__frame {
		border-radius: 9.6rem 2.4rem 2.4rem;
	}

	.frames__item--2 .frames__frame {
		border-radius: 2.4rem 9.6rem 2.4rem;
	}

	.frames__item--3 .frames__frame {
		border-radius: 2.4rem 2.4rem 9.6rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.frames__media {
			transition: transform 0.6s ease;
		}

		.frames__frame:hover .frames__media {
			transform: scale(1.05);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.frames__item {
			animation: none;
			opacity: 1;
			transform: none;
		}

		.frames__media {
			transition: none;
		}
	}
</style>